{
  "sequence_id": "multi_review",
  "description": "List files, read each one, summarize all contents",
  "steps": [
    {
      "step_id": "listing",
      "skill": "shell",
      "inputs": {"command": "find $input.directory -type f -not -name '.*'"},
      "retry": {"count": 1, "delay_seconds": 0},
      "on_error": "abort"
    },
    {
      "step_id": "files",
      "skill": "read_file",
      "loop_over": "$listing",
      "loop_item_input": "path",
      "retry": {"count": 1, "delay_seconds": 0},
      "on_error": "skip"
    },
    {
      "step_id": "summary",
      "type": "llm",
      "prompt": "Summarize each file's purpose in 2-3 sentences:\n\n$files.results",
      "on_error": "abort"
    }
  ]
}