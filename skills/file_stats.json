{
  "sequence_id": "file_stats",
  "description": "List files in a directory and count lines of code per file",
  "steps": [
    {
      "step_id": "listing",
      "skill": "list_files",
      "inputs": {"path": "$input.directory"},
      "retry": {"count": 1, "delay_seconds": 0},
      "on_error": "abort"
    },
    {
      "step_id": "count",
      "skill": "shell",
      "inputs": {"command": "find $input.directory -name '*.py' -exec wc -l {} +"},
      "retry": {"count": 1, "delay_seconds": 0},
      "on_error": "skip"
    },
    {
      "step_id": "summarize",
      "type": "llm",
      "prompt": "Summarize this project directory structure and code size.\n\nFiles:\n$listing\n\nLine counts:\n$count",
      "on_error": "abort"
    }
  ]
}